<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.DashboardFrame">
  <grid id="mainPanel" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="800" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="headerPanel" binding="headerPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lblUserInfo" class="javax.swing.JLabel" binding="lblUserInfo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Utente: "/>
            </properties>
          </component>
          <component id="btnLogout" class="javax.swing.JButton" binding="btnLogout">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Logout"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="tabbedPane" class="javax.swing.JTabbedPane" binding="tabbedPane">
        <constraints border-constraint="West"/>
        <properties/>
      </component>
    </children>
  </grid>
</form>
