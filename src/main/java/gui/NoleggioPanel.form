<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.NoleggioPanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="800" height="600"/>
    </constraints>
    <border type="none"/>
    <children>
      <scrollpane id="a1b2c">
        <constraints border-constraint="Center"/>
        <border type="none"/>
        <children>
          <component id="tabellaNoleggi" class="javax.swing.JTable" binding="tabellaNoleggi">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="btnChiudi" class="javax.swing.JButton" binding="btnChiudi">
        <constraints border-constraint="South"/>
        <properties>
          <text value="Chiudi Noleggio"/>
        </properties>
      </component>
    </children>
  </grid>
</form>