<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.PrenotazionePanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="600" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="a1b2c" binding="scrollPane">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabella" class="javax.swing.JTable" binding="tabella">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="toolbarOperatore" binding="toolbarOperatore" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btnConferma" class="javax.swing.JButton" binding="btnConferma">
            <constraints/>
            <properties>
              <enabled value="false"/>
              <text value="Conferma"/>
            </properties>
          </component>
          <component id="btnAnnulla" class="javax.swing.JButton" binding="btnAnnulla">
            <constraints/>
            <properties>
              <enabled value="false"/>
              <text value="Annulla"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>