<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.PrenotazionePanel">
  <grid id="mainPanel" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="scrollPane1">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabella" class="javax.swing.JTable" binding="tabella">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="btnConferma" class="javax.swing.JButton" binding="btnConferma">
        <constraints border-constraint="South"/>
        <properties>
          <text value="Conferma"/>
        </properties>
      </component>
    </children>
  </grid>
</form>