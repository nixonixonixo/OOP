<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.OperatorePanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="600" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="lblTitolo" class="javax.swing.JLabel" binding="lblTitolo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Arial" size="16" style="1"/>
          <text value="Pannello Operatore - Gestione Auto"/>
        </properties>
      </component>
      <scrollpane id="a1b2c" binding="scrollPane">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabellaAuto" class="javax.swing.JTable" binding="tabellaAuto">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="azioniPanel" binding="azioniPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btnManutenzione" class="javax.swing.JButton" binding="btnManutenzione">
            <constraints/>
            <properties>
              <text value="Manutenzione"/>
            </properties>
          </component>
          <component id="btnDisponibile" class="javax.swing.JButton" binding="btnDisponibile">
            <constraints/>
            <properties>
              <text value="Disponibile"/>
            </properties>
          </component>
          <component id="btnAggiorna" class="javax.swing.JButton" binding="btnAggiorna">
            <constraints/>
            <properties>
              <text value="Aggiorna"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>