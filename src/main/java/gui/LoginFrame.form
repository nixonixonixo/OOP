<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.LoginFrame">
  <grid id="mainPanel" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="2" hgap="10" vgap="10">
    <constraints>
      <xy x="20" y="20" width="400" height="250"/>
    </constraints>
    <margin top="20" left="20" bottom="20" right="20"/>
    <border type="none"/>
    <children>
      <component id="lblUsername" class="javax.swing.JLabel" binding="lblUsername">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Username:"/>
        </properties>
      </component>
      <component id="usernameField" class="javax.swing.JTextField" binding="usernameField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
      </component>
      <component id="lblPassword" class="javax.swing.JLabel" binding="lblPassword">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Password:"/>
        </properties>
      </component>
      <component id="passwordField" class="javax.swing.JPasswordField" binding="passwordField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
      </component>
      <grid id="panel1" layout-manager="FlowLayout" hgap="5" vgap="0" flow-align="1">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <border type="none"/>
        <children>
          <component id="loginButton" class="javax.swing.JButton" binding="loginButton">
            <constraints/>
            <properties>
              <text value="Login"/>
            </properties>
          </component>
          <component id="registerButton" class="javax.swing.JButton" binding="registerButton">
            <constraints/>
            <properties>
              <text value="Registrati"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>