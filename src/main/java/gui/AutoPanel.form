<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.AutoPanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="800" height="600"/>
    </constraints>
    <border type="none"/>
    <children>
      <scrollpane id="a1b2c" binding="scrollPane">
        <constraints border-constraint="Center"/>
        <border type="none"/>
        <children>
          <component id="table" class="javax.swing.JTable" binding="table">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="bottomPanel" binding="bottomPanel" layout-manager="FlowLayout" hgap="10" vgap="10">
        <constraints border-constraint="South"/>
        <border type="none"/>
        <children>
          <component id="btnAggiorna" class="javax.swing.JButton" binding="btnAggiorna">
            <constraints/>
            <properties>
              <text value="Aggiorna"/>
            </properties>
          </component>
          <component id="btnPrenota" class="javax.swing.JButton" binding="btnPrenota">
            <constraints/>
            <properties>
              <text value="Prenota"/>
            </properties>
          </component>
          <component id="btnManutenzione" class="javax.swing.JButton" binding="btnManutenzione">
            <constraints/>
            <properties>
              <text value="In Manutenzione"/>
            </properties>
          </component>
          <component id="btnRendiDisp" class="javax.swing.JButton" binding="btnRendiDisp">
            <constraints/>
            <properties>
              <text value="Rendi Disponibile"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>