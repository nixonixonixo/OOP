<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.ClientePanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="20" y="20" width="450" height="300"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="infoPanel" binding="infoPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lblNome" class="javax.swing.JLabel" binding="lblNome">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nome: "/>
            </properties>
          </component>
          <component id="lblEmail" class="javax.swing.JLabel" binding="lblEmail">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Email: "/>
            </properties>
          </component>
          <component id="lblCredito" class="javax.swing.JLabel" binding="lblCredito">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Credito Attuale: 0.00 €"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="ricaricaPanel" binding="ricaricaPanel" layout-manager="FlowLayout" hgap="10" vgap="10" flow-align="0" same-size-horizontally="false" same-size-vertically="false">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Ricarica Credito"/>
        <children>
          <component id="lblImportoDesc" class="javax.swing.JLabel" binding="lblImportoDesc">
            <constraints/>
            <properties>
              <text value="Importo (€):"/>
            </properties>
          </component>
          <component id="txtRicarica" class="javax.swing.JTextField" binding="txtRicarica">
            <constraints/>
            <properties>
              <columns value="10"/>
            </properties>
          </component>
          <component id="btnRicarica" class="javax.swing.JButton" binding="btnRicarica">
            <constraints/>
            <properties>
              <text value="Ricarica ora"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>