<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.ClientePanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="400" height="200"/>
    </constraints>
    <border type="none"/>
    <children>
      <grid id="infoPanel" binding="infoPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" hgap="5" vgap="5">
        <constraints border-constraint="North"/>
        <margin top="10" left="10" bottom="10" right="10"/>
        <border type="none"/>
        <children>
          <component id="lblNome" class="javax.swing.JLabel" binding="lblNome">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nome: "/>
            </properties>
          </component>
          <component id="lblEmail" class="javax.swing.JLabel" binding="lblEmail">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Email: "/>
            </properties>
          </component>
          <component id="lblCredito" class="javax.swing.JLabel" binding="lblCredito">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Credito: "/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="ricaricaPanel" binding="ricaricaPanel" layout-manager="FlowLayout" hgap="10" vgap="10">
        <constraints border-constraint="South"/>
        <border type="none"/>
        <children>
          <component id="lblImportoDesc" class="javax.swing.JLabel" binding="lblImportoDesc">
            <constraints/>
            <properties>
              <text value="Importo:"/>
            </properties>
          </component>
          <component id="txtRicarica" class="javax.swing.JTextField" binding="txtRicarica">
            <constraints/>
            <properties>
              <columns value="10"/>
            </properties>
          </component>
          <component id="btnRicarica" class="javax.swing.JButton" binding="btnRicarica">
            <constraints/>
            <properties>
              <text value="Ricarica"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>